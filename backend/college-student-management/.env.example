# =================================================================
# SK COLLEGE MANAGEMENT SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and fill in your actual environment secrets.
# =================================================================

# Server Port
PORT=4000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/college_crm

# JSON Web Token Secret Key (use a long, cryptographically random string)
JWT_SECRET=your_jwt_secret_key_here

# Client Application URL (CORS & Password Reset links)
FRONTEND_URL=http://localhost:3000

# Email Service (Nodemailer / Gmail App Password)
EMAIL=your_college_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_PASS=your_email_app_password

# Admin Recipient Email (for admission application alerts)
ADMIN_EMAIL=admin_notifications@skcollege.edu.in

# Optional Custom SMTP Server (defaults to Gmail if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_college_email@gmail.com
SMTP_PASS=your_email_app_password
