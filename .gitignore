# =================================================================
# SK COLLEGE MANAGEMENT SYSTEM - ROOT .GITIGNORE
# =================================================================

# Dependencies
node_modules/
backend/college-student-management/node_modules/
backend/college-student management/node_modules/
frontend/node_modules/

# Environment Variables & Secrets (CRITICAL: Never commit to Git)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/college-student-management/.env
backend/college-student-management/.env.*
backend/college-student management/.env
backend/college-student management/.env.*
frontend/.env
frontend/.env.*

# Always include and track safe .env.example templates
!.env.example
!**/.env.example
!.env*.example
!**/.env*.example

# Production Builds
frontend/build/
build/
dist/
.vercel

# Operating System Files & Artifacts
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Test Scripts & Local Testing Files (retained locally, excluded from Git)
scratch/
test_*.js
backend/college-student-management/test_*.js
backend/college-student management/test_*.js
frontend/tailwind-test.css

# Redundant Frontend Public Uploads (media is served dynamically by backend API)
frontend/public/uploads/

# User Uploads - Exclude general dynamic uploads while whitelisting the 8 essential seed images
backend/college-student-management/uploads/*
!backend/college-student-management/uploads/.gitkeep
!backend/college-student-management/uploads/1785489209125-about-us.jpg
!backend/college-student-management/uploads/1785489858420-sports.jpg
